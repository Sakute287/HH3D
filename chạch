    // Tính toán thời gian chờ đợi dựa trên Exponential Backoff với Jitter
    function getBackoffTime(retryCount, baseDelay = 2000, maxDelay = 15000) {
        const tempDelay = baseDelay * Math.pow(2, retryCount);
        const delay = Math.min(tempDelay, maxDelay);
        const jitter = Math.random() * (delay * 0.5); // Thêm 0-50% nhiễu ngẫu nhiên
        return delay + jitter;
    }

    async function antiBotFetch(url, options = {}, retryCount = 0) {
        const MAX_RETRIES = 3;

        // Đảm bảo khoảng cách tối thiểu giữa đầu mỗi request
        const now = Date.now();
        const elapsed = now - lastRequestTime;
        if (elapsed < currentMinRequestGap) {
            const delay = currentMinRequestGap - elapsed + Math.floor(Math.random() * 500);
            await sleep(delay);
        }
        lastRequestTime = Date.now();

        // Khoảng nghỉ ngẫu nhiên mô phỏng hành động tự nhiên
        await sleep(800 + Math.floor(Math.random() * 1200));

        try {
            const res = await originalFetch(url, options);

            // Tự động xử lý khi gặp mã giới hạn tần suất từ máy chủ (429 hoặc 503)
            if ((res.status === 429 || res.status === 503) && retryCount < MAX_RETRIES) {
                const retryAfterHeader = res.headers.get('Retry-After');
                let backoff = 0;

                if (retryAfterHeader) {
                    backoff = isNaN(retryAfterHeader)
                        ? (Date.parse(retryAfterHeader) - Date.now())
                        : parseInt(retryAfterHeader, 10) * 1000;
                }

                // Nếu không có header hoặc thời gian quá ngắn, tính toán backoff lũy thừa
                if (backoff <= 0) {
                    backoff = getBackoffTime(retryCount);
                }

                // Tạm thời tăng khoảng cách tối thiểu giữa các yêu cầu tiếp theo
                currentMinRequestGap = Math.min(currentMinRequestGap + 1000, 5000);

                console.warn(`[Client-Compliance] Nhận mã phản hồi ${res.status}. Tạm dừng thực hiện và thử lại sau ${Math.round(backoff)}ms...`);
                await sleep(backoff);
                return antiBotFetch(url, options, retryCount + 1);
            }

            // Nếu thành công và không bị giới hạn, khôi phục dần khoảng cách tối thiểu ban đầu
            if (res.ok && currentMinRequestGap > 1500) {
                currentMinRequestGap = Math.max(currentMinRequestGap - 500, 1500);
            }

            return res;
        } catch (err) {
            if (retryCount < MAX_RETRIES && (err.message.includes('Failed to fetch') || err.message.includes('NetworkError'))) {
                const backoff = getBackoffTime(retryCount);
                console.warn(`[Client-Compliance] Lỗi mạng khi gửi request. Thử lại sau ${Math.round(backoff)}ms...`);
                await sleep(backoff);
                return antiBotFetch(url, options, retryCount + 1);
            }
            throw err;
        }
    }

