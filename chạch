    // Hàng đợi tuần tự để đảm bảo các yêu cầu không bao giờ chồng chéo lên nhau
    class RequestSerializer {
        constructor() {
            this.promise = Promise.resolve();
        }
        enqueue(action) {
            this.promise = this.promise.then(action).catch(err => {
                console.error('[RequestSerializer] Error in queued task:', err);
                // Trả về lỗi để không làm đứt chuỗi hàng đợi nhưng vẫn báo cho caller biết
