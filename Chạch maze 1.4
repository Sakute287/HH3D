// ==UserScript==
// @name        Chạch maze 1.4
// @namespace    https://hoathinh3d.*/
// @version      1.4
// @description  Tự động xử lý Mê Cung: đợi đủ 4 người, bật Auto, bắt đầu trận, xác nhận, bật Auto Tấn Công, mở rương, quay về sảnh.
// @include https://hoathinh3d.*/me-cung
// @grant        none
// ==/UserScript==

(() => {
    'use strict';

    const LOG = '[HH3D Mê Cung Auto 4P]';
    const CHECK_INTERVAL = 250;
    const ACTION_COOLDOWN = 750;

    const SELECTORS = {
        startButton: '#btn-start',
        confirmButton: '.confirm-btn-ok',
        battleFrame: '#battle-frame',
        autoAttackTrack: '#auto-attack-track',
        autoAttackToggle: '#auto-attack-toggle',
        autoReadyTrack: '#auto-ready-track',
        autoReadyToggle: '#auto-ready-row button',
        autoNextStageTrack: '#auto-next-stage-track',
        autoNextStageToggle: '#auto-next-stage-row button',
        autoOpenChestTrack: '#auto-open-chest-track',
        autoOpenChestToggle: '#auto-open-chest-row button',
        chestInplace: '#b5-chest-inplace',
        chestCountdown: '#b5-chest-countdown',
        chestWrap: '#b5-chest-wrap',
        rewardBox: '.reward-box',
        backLobbyButton: '.reward-box .btn-back-lobby'
    };

    const ROOM_PLAYER_SELECTORS = [
        '.room-member',
        '.member-item',
        '.player-item',
        '.room-user',
        '.user-item',
        '.lobby-player',
        '.player-card',
        '.char-card',
        '.member',
        '.room-players .item',
        '.players .item',
        '.player-list .item',
        '.member-list .member',
        '.user-list .user'
    ];

    const ROOM_COUNT_SELECTORS = [
        '#room-player-count',
        '#player-count',
        '.room-player-count',
        '.player-count',
        '.room-member-count',
        '.member-count',
        '.room-count',
        '.room-user-count'
    ];

    let lastActionAt = 0;
    let startedCurrentCycle = false;
    let confirmHandled = false;
    let battleAutoHandled = false;
    let chestHandled = false;
    let rewardHandled = false;
    let lastState = 'unknown';
    let observerScheduled = false;
    let lastPlayerCountLog = -1;

    function isVisible(element) {
        if (!element) return false;
        if (element.hidden) return false;
        if (element.getClientRects && element.getClientRects().length === 0) return false;

        const style = getComputedStyle(element);
        return style.display !== 'none' && style.visibility !== 'hidden';
    }

    function canAct() {
        const now = Date.now();
        if (now - lastActionAt < ACTION_COOLDOWN) return false;
        lastActionAt = now;
        return true;
    }

    function clickOnce(selector, label) {
        const el = document.querySelector(selector);
        if (!isVisible(el)) return false;
        if (!canAct()) return false;

        el.click();
        console.log(`${LOG} ${label}`);
        return true;
    }

    function getTextNumber(value) {
        if (value === null || value === undefined) return NaN;
        const text = String(value).replace(/[^0-9]/g, '');
        if (!text) return NaN;
        return Number(text);
    }

    function getVisibleRoomPlayerCount() {
        // 1) Ưu tiên selector count dạng số
        for (const selector of ROOM_COUNT_SELECTORS) {
            const el = document.querySelector(selector);
            if (!el || !isVisible(el)) continue;

            const n = getTextNumber(el.textContent || el.value || el.innerText);
            if (!Number.isNaN(n)) return n;
        }

        // 2) Nếu không có số count, thử đếm phần tử trong room
        let maxCount = 0;
        for (const selector of ROOM_PLAYER_SELECTORS) {
            const nodes = [...document.querySelectorAll(selector)];
            const visibleCount = nodes.filter(el => isVisible(el)).length;
            if (visibleCount > maxCount) maxCount = visibleCount;
        }

        // 3) Một số game hiển thị "đã có 1/4" dạng text
        const textNodes = document.querySelectorAll(
            '.room-member-count, .member-count, .player-count, .room-count, .room-user-count, .player-status'
        );
        for (const node of textNodes) {
            if (!isVisible(node)) continue;
            const n = getTextNumber(node.textContent || node.innerText);
            if (!Number.isNaN(n)) {
                if (n > maxCount) maxCount = n;
            }
        }

        return maxCount;
    }

    function hasEnoughPlayers() {
        const count = getVisibleRoomPlayerCount();

        // Nếu count rõ ràng
        if (!Number.isNaN(count) && count > 0) {
            return count >= 4;
        }

        // Nếu không đọc được count, nhưng phòng chờ đang có start button và các room autostart ready
        // thì cố gắng không bắt đầu quá sớm. Ở chế độ an toàn, hãy chờ 4 người bằng cách
        // dùng selector room count nếu có trong DOM; nếu không có, không khởi động quá sớm.
        const startBtn = document.querySelector(SELECTORS.startButton);
        return !!startBtn && isVisible(startBtn) && false;
    }

    function trackIsOn(trackSelector) {
        const track = document.querySelector(trackSelector);
        return !!track && track.classList.contains('on');
    }

    function ensureToggle(trackSelector, buttonSelector, label) {
        const track = document.querySelector(trackSelector);
        const button = document.querySelector(buttonSelector);

        if (!isVisible(track) || !isVisible(button)) return false;
        if (track.classList.contains('on')) return false;
        if (!canAct()) return false;

        button.click();
        console.log(`${LOG} 🤖 Đã bật ${label}`);
        return true;
    }

    function getState() {
        const rewardBox = document.querySelector(SELECTORS.rewardBox);
        if (isVisible(rewardBox)) return 'reward';

        const chest = document.querySelector(SELECTORS.chestInplace);
        if (isVisible(chest)) return 'chest';

        const battle = document.querySelector(SELECTORS.battleFrame);
        if (isVisible(battle)) return 'battle';

        const confirm = document.querySelector(SELECTORS.confirmButton);
        if (isVisible(confirm)) return 'confirm';

        const start = document.querySelector(SELECTORS.startButton);
        const readyTrack = document.querySelector(SELECTORS.autoReadyTrack);
        const roomPlayerCount = getVisibleRoomPlayerCount();

        if (isVisible(start) || isVisible(readyTrack) || roomPlayerCount > 0) {
            return 'waiting-room';
        }

        return 'lobby';
    }

    function resetCycleFlags() {
        startedCurrentCycle = false;
        confirmHandled = false;
        battleAutoHandled = false;
        chestHandled = false;
        rewardHandled = false;
    }

    function announceState(state) {
        if (state === lastState) return;
        lastState = state;
        console.log(`${LOG} 📍 State: ${state}`);
    }

    function handleWaitingRoom() {
        // 1) Bật các auto ở phòng chờ
        ensureToggle(SELECTORS.autoReadyTrack, SELECTORS.autoReadyToggle, 'Tự động sẵn sàng');
        ensureToggle(SELECTORS.autoNextStageTrack, SELECTORS.autoNextStageToggle, 'Tự động chuyển ải');
        ensureToggle(SELECTORS.autoOpenChestTrack, SELECTORS.autoOpenChestToggle, 'Tự động mở rương');

        const startBtn = document.querySelector(SELECTORS.startButton);
        const playerCount = getVisibleRoomPlayerCount();

        if (playerCount > 0 && playerCount < 4) {
            if (playerCount !== lastPlayerCountLog) {
                console.log(`${LOG} ⏳ Đợi đủ người: ${playerCount}/4`);
                lastPlayerCountLog = playerCount;
            }
            return;
        }

        lastPlayerCountLog = playerCount;

        // 2) Chỉ đánh start khi đủ người và chưa start cycle này
        if (!startedCurrentCycle && isVisible(startBtn) && !startBtn.disabled && hasEnoughPlayers()) {
            if (clickOnce(SELECTORS.startButton, '▶️ Đã bấm BẮT ĐẦU')) {
                startedCurrentCycle = true;
                confirmHandled = false;
            }
        }
    }

    function handleConfirm() {
        if (confirmHandled) return;
        if (clickOnce(SELECTORS.confirmButton, '✅ Đã bấm XÁC NHẬN')) {
            confirmHandled = true;
        }
    }

    function handleBattle() {
        if (battleAutoHandled) return;

        const track = document.querySelector(SELECTORS.autoAttackTrack);
        const toggle = document.querySelector(SELECTORS.autoAttackToggle);

        if (!isVisible(track) || !isVisible(toggle)) return;

        if (track.classList.contains('on')) {
            console.log(`${LOG} 🤖 Auto Tấn Công đã ON sẵn.`);
            battleAutoHandled = true;
            return;
        }

        if (clickOnce(SELECTORS.autoAttackToggle, '🤖 Đã bật TỰ ĐỘNG TẤN CÔNG')) {
            battleAutoHandled = true;
        }
    }

    function handleChest() {
        if (chestHandled) return;

        const chest = document.querySelector(SELECTORS.chestInplace);
        const countdown = document.querySelector(SELECTORS.chestCountdown);
        const chestWrap = document.querySelector(SELECTORS.chestWrap);

        if (!isVisible(chest) || !isVisible(countdown) || !isVisible(chestWrap)) return;

        const text = (countdown.textContent || '').trim();
        if (text !== '✅ Rương đã sẵn sàng!') return;

        if (clickOnce(SELECTORS.chestWrap, '🎁 Rương đã sẵn sàng → Đã click mở rương')) {
            chestHandled = true;
        }
    }

    function handleReward() {
        if (rewardHandled) return;

        const rewardBox = document.querySelector(SELECTORS.rewardBox);
        const backButton = document.querySelector(SELECTORS.backLobbyButton);

        if (!isVisible(rewardBox) || !isVisible(backButton)) return;

        if (clickOnce(SELECTORS.backLobbyButton, '🏠 Đã bấm QUAY VỀ SẢNH → loop lại')) {
            rewardHandled = true;
        }
    }

    function runStateMachine() {
        const previousState = lastState;
        const state = getState();
        announceState(state);

        // Reset cycle khi vào lại phòng chờ / khởi động lại từ reward hoặc lobby
        if (state === 'waiting-room' && previousState !== 'waiting-room') {
            resetCycleFlags();
        }

        switch (state) {
            case 'waiting-room':
                handleWaitingRoom();
                break;

            case 'confirm':
                handleConfirm();
                break;

            case 'battle':
                handleBattle();
                break;

            case 'chest':
                handleChest();
                break;

            case 'reward':
                handleReward();
                break;

            case 'lobby':
            default:
                break;
        }
    }

    function scheduleRun() {
        if (observerScheduled) return;
        observerScheduled = true;

        setTimeout(() => {
            observerScheduled = false;
            try {
                runStateMachine();
            } catch (error) {
                console.error(`${LOG} ❌ Lỗi state machine:`, error);
            }
        }, 40);
    }

    function start() {
        console.log(`${LOG} 🚀 Khởi động bot mê cung 4 người.`);
        const observer = new MutationObserver(() => {
            scheduleRun();
        });

        observer.observe(document.documentElement || document, {
            subtree: true,
            childList: true,
            attributes: true,
            attributeFilter: ['class', 'style', 'hidden', 'disabled']
        });

        setInterval(runStateMachine, CHECK_INTERVAL);
        scheduleRun();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
        start();
    }
})();
